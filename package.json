{
    "name": "explorer",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "audit": "pnpm audit --audit-level high",
        "audit:ci": "pnpm audit --prod --audit-level critical",
        "audit:prod": "pnpm audit --prod --audit-level high",
        "build": "pnpm build:packages && next build",
        "check": "pnpm format:ci && pnpm lint && pnpm openspec:validate && pnpm build && pnpm test:ci",
        "build:info": "node scripts/update-build-info.js",
        "build:packages": "pnpm -r --filter './packages/**' run build",
        "build-sb": "storybook build",
        "design-sb": "storybook dev -p 6007 --config-dir storybook-design/.storybook",
        "coverage": "vitest --coverage",
        "dev": "pnpm build:packages && next dev",
        "eslint:lint": "eslint",
        "format": "pnpm format:md && pnpm pretty:format '**/*.{ts,tsx,mts,mjs,cjs}' '*.json'",
        "format:ci": "pnpm format",
        "format:md": "pnpm pretty:format 'app/mcp/**/*.md'",
        "gen": "pnpx shadcn@^2.4.0 add",
        "lint": "pnpm -r --filter './packages/**' run lint && pnpm eslint:lint .",
        "openspec:validate": "openspec validate --all --strict --no-interactive",
        "pretty:format": "prettier --config .prettierrc.cjs --check",
        "sb": "storybook dev -p 6006",
        "scan": "next dev & react-scan localhost:3000",
        "start": "next start",
        "test": "pnpm test:ci",
        "test:changed": "pnpm vitest:test related --run",
        "test:packages:changed": "pnpm --filter \"./packages/**\" run --if-present test:changed",
        "test:ci": "pnpm test:packages && pnpm test:ci:specs",
        "test:ci:specs": "pnpm vitest:test run",
        "test:e2e": "playwright test",
        "test:e2e:ci": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:packages": "pnpm -r --filter './packages/**' run test",
        "pretest:sb": "pnpm build:packages",
        "test:sb": "vitest --project storybook run",
        "test:sb:changed": "vitest --project storybook --changed --run",
        "test:sb:coverage": "vitest --project storybook run --coverage",
        "test:sb:watch": "vitest --project storybook --watch",
        "test:watch": "vitest --project specs --watch",
        "pretypecheck": "pnpm typegen",
        "typecheck": "pnpm typecheck:packages && tsc --noEmit",
        "typegen": "next typegen",
        "typecheck:packages": "pnpm -r --filter './packages/**' run typecheck",
        "vitest:test": "vitest --project specs"
    },
